  "inhalt": {
    "name": "URS-App",
    "zweck": "Terminal wie Warp: jedes Vorhaben erst als Ablauf planen, freigeben, dann im selben Terminal bauen.",
    "anforderungen": [
      {
        "id": "U1",
        "text": "Nach einer App-Idee in Claude Code steht der Ablauf in 10 Sekunden im Browser.",
        "prio": "muss"
      },
      {
        "id": "U2",
        "text": "Eine neue Version öffnet sich im Browser von selbst.",
        "prio": "muss"
      },
      {
        "id": "U3",
        "text": "Jeder Knoten hat höchstens 4 Wörter.",
        "prio": "muss"
      },
      {
