{
  "version": 18,
  "erstellt": "2026-10-11T08:12:51.713Z",
  "inhalt": {
    "name": "URS-App",
    "zweck": "Terminal: jedes Vorhaben erst als Ablauf planen, freigeben, dann im selben Terminal bauen.",
    "anforderungen": [
      {
        "id": "U1",
        "text": "Der Ablauf steht spätestens 10 Sekunden nach der Idee im Browser.",
        "prio": "muss"
      },
      {
        "id": "U2",
        "text": "Eine neue Version öffnet sich im Browser von selbst.",
        "prio": "muss"
      },
      {
        "id": "U3",
        "text": "Jeder Knoten hat höchstens 4 Wörter.",
        "prio": "muss"
      },
      {
        "id": "U4",
        "text": "Änderungen seit der letzten Version sind farbig markiert.",
        "prio": "muss",
        "gestrichen": true
      },
      {
        "id": "U5",
        "text": "Kommentare an Knoten bleiben nach Neuladen erhalten.",
        "prio": "muss"
      },
      {
        "id": "U6",
        "text": "Knoten anlegen, verschieben, löschen und Pfeile ziehen geht per Maus.",
        "prio": "muss"
      },
      {
        "id": "U7",
        "text": "„Freigeben“ geht erst, wenn kein Kommentar und keine Frage offen ist.",
        "prio": "muss"
      },
      {
        "id": "U8",
        "text": "Claude bekommt jeden Kommentar und jede Änderung zurück.",
        "prio": "muss"
      },
      {
        "id": "U9",
        "text": "Eine freigegebene Version lässt sich nicht mehr ändern.",
        "prio": "muss"
      },
      {
        "id": "U10",
        "text": "Claude bekommt die URS erst nach der Freigabe.",
        "prio": "muss"
      },
      {
        "id": "U11",
        "text": "Je Anforderung steht nur ein Satz da, ohne Quelle und Zusatzfelder.",
        "prio": "muss"
      },
      {
        "id": "U12",
        "text": "Ein neuer Knoten überdeckt nie einen bestehenden.",
        "prio": "muss"
      },
      {
        "id": "U13",
        "text": "Shift+Enter macht in Terminal und Block-Feld eine neue Zeile, ohne abzuschicken.",
        "prio": "muss"
      },
      {
        "id": "U14",
        "text": "Die Ordner-Spalte links lässt sich per Klick aus- und wieder einblenden.",
        "prio": "muss"
      },
      {
        "id": "U15",
        "text": "Das ganze Seitenfeld rechts lässt sich per Klick aus- und wieder einblenden.",
        "prio": "muss"
      },
      {
        "id": "U16",
        "text": "Vor der Freigabe baut Claude nichts, sondern plant zuerst den Ablauf.",
        "prio": "muss"
      },
      {
        "id": "U17",
        "text": "Nach der Freigabe baut Claude im selben Terminal nur die freigegebene Version.",
        "prio": "muss"
      },
      {
        "id": "U18",
        "text": "Ein neuer Wunsch beim Bauen geht zuerst zurück ins Planen.",
        "prio": "muss"
      },
      {
        "id": "U19",
        "text": "Der Fensterkopf zeigt immer, ob gerade geplant oder gebaut wird.",
        "prio": "muss"
      },
      {
        "id": "U20",
        "text": "Ausgeblendete Spalten bleiben auch nach einem Neustart ausgeblendet.",
        "prio": "muss"
      },
      {
        "id": "U21",
        "text": "Das Terminal links lässt sich per Klick aus- und wieder einblenden.",
        "prio": "muss"
      },
      {
        "id": "U22",
        "text": "Breiten von Leiste, Terminal, Ablauf und Seitenfeld lassen sich ziehen.",
        "prio": "muss"
      },
      {
        "id": "U23",
        "text": "Eingestellte Breiten bleiben auch nach einem Neustart erhalten.",
        "prio": "muss"
      },
      {
        "id": "U24",
        "text": "Claude darf eingearbeitete Kommentare selbst als erledigt abhaken.",
        "prio": "muss"
      },
      {
        "id": "U25",
        "text": "Claude im Terminal nutzt die eigenen Claude-Code-Einstellungen und -Werkzeuge.",
        "prio": "muss"
      },
      {
        "id": "U26",
        "text": "Projekt aus der Übersicht entfernen löscht keine Ordner oder Dateien.",
        "prio": "muss"
      },
      {
        "id": "U27",
        "text": "Strg+T öffnet einen neuen Chat; alle Chats laufen links weiter.",
        "prio": "muss"
      },
      {
        "id": "U28",
        "text": "Seitenfeld: oben Knopf zum Einklappen, eingeklappt Streifen zum Aufklappen.",
        "prio": "muss"
      },
      {
        "id": "U29",
        "text": "Klick auf einen Block öffnet das Seitenfeld, auch eingeklappt.",
        "prio": "muss"
      },
      {
        "id": "U30",
        "text": "Das Block-Feld zeigt keine Hinweistexte, nur Eingabe und Knopf.",
        "prio": "muss"
      },
      {
        "id": "U31",
        "text": "Noch nicht Freigegebenes trägt in der URS die Marke „neu“.",
        "prio": "muss"
      },
      {
        "id": "U32",
        "text": "Ein Chat heißt wie sein Projekt, ohne Zusatzzeile darunter.",
        "prio": "muss"
      },
      {
        "id": "U33",
        "text": "Doppelklick auf einen Chatnamen benennt ihn dauerhaft um.",
        "prio": "muss"
      },
      {
        "id": "U34",
        "text": "Ein neuer Chat fragt immer nach dem Ordner.",
        "prio": "muss"
      },
      {
        "id": "U35",
        "text": "Strg+W schließt den Chat, Strg+Tab wechselt, Cmd+1–9 springt zu Chat 1–9.",
        "prio": "muss"
      },
      {
        "id": "U36",
        "text": "Ordner mit Leerzeichen am Namensanfang oder -ende lassen sich öffnen.",
        "prio": "muss"
      },
      {
        "id": "U37",
        "text": "Ein Chat kann auch die URS eines Unterordners planen und bauen.",
        "prio": "muss"
      },
      {
        "id": "U38",
        "text": "Claude sieht nach jedem Entwurf das Fließbild als Bild.",
        "prio": "muss"
      },
      {
        "id": "U39",
        "text": "Screenshots lassen sich in Terminal und Block-Feld einfügen; Claude sieht sie.",
        "prio": "muss"
      },
      {
        "id": "U40",
        "text": "Kein Knoten, Pfeil oder Beschriftung überdeckt einen anderen, auch nach Überarbeitungen.",
        "prio": "muss"
      },
      {
        "id": "U41",
        "text": "Das Fließbild ordnet sich selbst von oben nach unten, kreuzungsarm.",
        "prio": "muss"
      },
      {
        "id": "U42",
        "text": "U-Nummern stehen nicht neben den Knoten, sondern erst nach Klick im Seitenfeld.",
        "prio": "muss"
      },
      {
        "id": "U43",
        "text": "Überlappungen bessert Claude nach, bevor der Nutzer die Version sieht.",
        "prio": "muss"
      },
      {
        "id": "U44",
        "text": "Von Hand verschobene Knoten bleiben an ihrem Platz.",
        "prio": "muss"
      },
      {
        "id": "U45",
        "text": "Ein Knopf „Aufräumen“ ordnet das ganze Fließbild auf Wunsch neu.",
        "prio": "muss"
      },
      {
        "id": "U46",
        "text": "Die App zeigt oben links neben ihrem Namen ihre Versionsnummer.",
        "prio": "muss"
      },
      {
        "id": "U47",
        "text": "Jede neu gebaute App bekommt eine höhere Versionsnummer als die vorige.",
        "prio": "muss"
      },
      {
        "id": "U48",
        "text": "Jede Anforderung ist ein konkreter, prüfbarer Satz mit höchstens 12 Wörtern.",
        "prio": "muss"
      },
      {
        "id": "U49",
        "text": "Vergleiche wie „wie in Warp“ sind verboten; das gemeinte Verhalten steht da.",
        "prio": "muss"
      },
      {
        "id": "U50",
        "text": "Die App weist jede Version mit zu langen oder vagen Sätzen zurück.",
        "prio": "muss"
      },
      {
        "id": "U51",
        "text": "Claude kürzt zurückgewiesene Sätze, bevor der Nutzer die Version sieht.",
        "prio": "muss"
      }
    ],
